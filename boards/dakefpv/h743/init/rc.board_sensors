#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# Primary IMU: ICM42688p on SPI1 (Rotation: Roll 180)
icm42688p -s -b 1 -R 0 start

# Secondary IMU: ICM42688p on SPI4 (Rotation: Pitch 180)
icm42688p -s -b 4 -R 4 start

# Onboard Barometer: SPL06 on I2C2
spl06 -I -b 2 start
